# ===== CrystalMuse Payment Server - Environment Configuration =====
# Copy this file to .env and fill in your actual keys
# cp .env.example .env

# ===== Server =====
PORT=8080
# For production, set to your domain: https://yourdomain.com
DOMAIN=http://localhost:8080

# ===== Stripe =====
# Get your keys at: https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
# Webhook signing secret (from Stripe Dashboard > Developers > Webhooks)
# Used to verify webhook authenticity. Optional in dev, required in production.
STRIPE_WEBHOOK_SECRET=

# ===== PayPal =====
# Get your credentials at: https://developer.paypal.com/dashboard/applications/sandbox
# Create a REST API app to get Client ID and Secret
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# Set to 'live' for production, 'sandbox' for testing
PAYPAL_MODE=sandbox

# ===== Email (SMTP) =====
# Leave blank to run in DEV mode (emails printed to console instead of sent).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@yourdomain.com

# ===== Customer Accounts (JWT) =====
# Secret used to sign customer login tokens. MUST be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_smtp_user
# EMAIL_PASS=your_smtp_password
# EMAIL_FROM=no-reply@yourdomain.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@aurae.shop
